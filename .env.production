# URL publica de la API de contacto. Next.js hornea las variables NEXT_PUBLIC_*
# en tiempo de compilacion, asi que debe estar disponible durante el build
# (tanto en local como en CI) o el formulario queda apuntando a "undefined".
# No es un secreto: viaja en el bundle que descarga el navegador.
NEXT_PUBLIC_API_SEND=https://api.larayap.com/apiSendMailPortfolio
